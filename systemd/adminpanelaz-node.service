[Unit]
Description=AdminPanelAZ Node Agent (AntiZapret remote node)
Documentation=file:///opt/AdminPanelAZ/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/AdminPanelAZ/backend
EnvironmentFile=-/opt/AdminPanelAZ/backend/node_agent.env
Environment=NODE_AGENT_STATE_DIR=/var/lib/adminpanelaz-node
Environment=NODE_AGENT_HOST=0.0.0.0
Environment=ANTIZAPRET_PATH=/root/antizapret
# NODE_AGENT_PORT и NODE_AGENT_API_KEY живут только в node_agent.env (EnvironmentFile
# выше) — не дублировать их здесь как Environment=, иначе systemd применяет их ПОСЛЕ
# EnvironmentFile и любая правка .env-файла молча игнорируется.
ExecStart=/opt/AdminPanelAZ/scripts/systemd-exec-node.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adminpanelaz-node

[Install]
WantedBy=multi-user.target
